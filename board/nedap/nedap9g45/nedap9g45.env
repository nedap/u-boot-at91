/*
 * Built-in default environment for the Nedap Renos AT91SAM9G45 board.
 *
 * U-Boot only falls back to this when both redundant copies in the u-boot-env
 * NAND partition are unreadable. A valid NAND environment is imported without
 * H_NOCLEAR and therefore replaces every value below.
 *
 * The values are the canonical Renos boot chain and are byte-identical to the
 * writers that own the environment at runtime:
 *   renos-os/support/osmigrate/recovery/init
 *   renos-os/meta-renos/recipes-core/osmigrate-finalizer/files/canonical-env.lib
 *   renos-os/support/bootchain-update/INSTALL
 *   renos-os/meta-renos/recipes-devtools/sam-ba/sam-ba/INSTALL-nedap9g45.tcl
 * renos-os/bin/check-canonical-env-contract enforces that from the Renos build
 * and fails it on any key here that no in-tree writer defines.
 *
 * fpga_readbitfile is the one deliberate difference. Those writers resolve the
 * RF variant per unit and store the answer; a default compiled into the binary
 * has no unit to read and branches on the PD17 strap, as SAM-BA provisioning
 * does.
 *
 * Deliberately absent, because they only exist per unit or per build and must
 * come from NAND: serial#, ethaddr, pcbID, hwversion, hwtype, ssh_public_key,
 * private_key, fpgabitfile_size, fpgabitfile_rev2_size.
 *
 * Also absent: bootcmd (CONFIG_BOOTCOMMAND), bootdelay (CONFIG_BOOTDELAY),
 * baudrate (CONFIG_BAUDRATE) and mtdids/mtdparts (CONFIG_MTDIDS_DEFAULT and
 * CONFIG_MTDPARTS_DEFAULT), all of which the default environment already
 * carries.
 *
 * kernel_active is per-unit state that firmware updates flip, and no default
 * can know which slot a unit was running, so a unit that loses its environment
 * comes back on kernel_a. It boots and is reachable, and the slot follows again
 * as soon as the environment is written back.
 */

/* Console and network defaults. */
stdin=serial
stdout=serial
stderr=serial
autoload=no

/* Kernel slots. */
kernel1=kernel_a
kernel2=kernel_b
kernel_active=kernel_a
kernelloadaddr=0x72000000
kernel_args=panic=1 quiet

/* Root filesystem. */
kernel_ubi_read=ubi part rootfs
rootfs_ubi_mount=run kernel_ubi_read && ubifsmount ubi0:nedap9g45-rootfs
rootfs_ubi_args=root=ubi0:nedap9g45-rootfs rw ubi.mtd=3,512 rootfstype=ubifs

/*
 * FPGA/RF. fpga_readbitfile picks the bitstream from the PD17 strap: the AT91
 * compat form of `gpio read` enables the pull-up, prints the level and returns
 * it, so a floating pin (RF1) returns 1 and a grounded pin (RF2) returns 0.
 *
 * fpga_recover_serial reads serial# back from the FPGA and its saveenv persists
 * whatever is in RAM, so `env exists ethaddr` gates it. ethaddr is absent below,
 * which leaves this copy inert and arms only the NAND copy every unit carries.
 */
fpgabitfile=fpga_rf_1
fpgabitfile_rev2=fpga_rf_2
fpgaparams=/home/root/xc3sprog/fpgaparams
fpga_readbitfile_1=setenv fpgaloadsize ${fpgabitfile_size} && ubi read 0x70000000 ${fpgabitfile} ${fpgabitfile_size}
fpga_readbitfile_2=setenv fpgaloadsize ${fpgabitfile_rev2_size} && ubi read 0x70000000 ${fpgabitfile_rev2} ${fpgabitfile_rev2_size}
fpga_readbitfile=if gpio read pd17 1 ; then run fpga_readbitfile_2 ; else run fpga_readbitfile_1 ; fi
fpga_loadbitfile=fpga load 0 0x70000000 ${fpgaloadsize}
fpga_testbitfile=fpgatst || echo RF test failed - continuing to Linux
fpga_loadparams=ubifsload 0x70000000 ${fpgaparams} && fpgaset 0x70000000 ${filesize}
fpga_loadsettings=run rootfs_ubi_mount && run fpga_loadparams && fpgaser
fpga_recover_serial=env exists ethaddr && run rootfs_ubi_mount && if gpio read pd17 1 ; then ubifsload 0x70000000 /home/root/xc3sprog/rheas_rf_2_top_copycode.bit ; else ubifsload 0x70000000 /home/root/xc3sprog/CopyCode_picoblaze_circuit.bit ; fi && fpga load 0 0x70000000 ${filesize} && fpgagetser && saveenv
fpga_load=env exists serial# || run fpga_recover_serial ; run fpga_readbitfile && run fpga_loadbitfile && run fpga_testbitfile

/* Boot chain. boot_fpga uses ';' so a failed RF load still boots Linux. */
boot_ubi1=ubi read ${kernelloadaddr} ${kernel1} && setenv bootargs ${kernel_args} ${mtdparts} ${rootfs_ubi_args} renos.kernel_slot=${kernel1} && bootm ${kernelloadaddr}
boot_ubi2=ubi read ${kernelloadaddr} ${kernel2} && setenv bootargs ${kernel_args} ${mtdparts} ${rootfs_ubi_args} renos.kernel_slot=${kernel2} && bootm ${kernelloadaddr}
boot_active=if test x${kernel_active} = xkernel_b ; then run boot_ubi2 ; else run boot_ubi1 ; fi
boot_fallback=if test x${kernel_active} = xkernel_b ; then run boot_ubi1 ; else run boot_ubi2 ; fi
boot_ubi=run kernel_ubi_read && run boot_active || run boot_fallback
boot_fpga=run kernel_ubi_read && run fpga_load ; run boot_ubi
boot_flash=run reflash_check ; run boot_fpga

/* USB-stick factory reflash. The pre-migration chain that flashed the rootfs
 * straight from U-Boot is gone: on a multi-volume unit only the recovery can
 * write a rootfs, so those commands could never succeed. */
usb_ls=fatls usb 0:0 /boot || fatls usb 0:1 /boot
usb_checkdir=usb start && run usb_ls && echo dir: OK
usb_factory_check=if fatsize usb 0:0 /boot/renos-rootfs.bin && fatsize usb 0:0 /boot/recovery-kernel/renos-rootfs.bin && fatsize usb 0:0 /boot/recovery-initrd/renos-rootfs.bin ; then setenv usbdev 0:0 ; else fatsize usb 0:1 /boot/renos-rootfs.bin && fatsize usb 0:1 /boot/recovery-kernel/renos-rootfs.bin && fatsize usb 0:1 /boot/recovery-initrd/renos-rootfs.bin && setenv usbdev 0:1 ; fi
usb_factory_accept=gpio write pd30 0
usb_factory_fail=gpio write pd30 1 && test 0 = 1
usb_recovery_load_kernel=fatload usb ${usbdev} ${kernelloadaddr} /boot/recovery-kernel/renos-rootfs.bin
usb_recovery_load_initrd=fatload usb ${usbdev} 0x74000000 /boot/recovery-initrd/renos-rootfs.bin
usb_recovery_boot=setenv initrd_high 0xffffffff && setenv bootargs console=ttyS0,115200 panic=10 loglevel=7 ${mtdparts} root=/dev/ram0 rw rdinit=/init osmigrate.recovery=1 osmigrate.mode=usb-factory-reflash osmigrate.confirm=YES_REFLASH_NEDAP9G45 && bootm ${kernelloadaddr} 0x74000000
usb_factory_prog=run usb_checkdir && run usb_factory_check && run usb_factory_accept && run usb_recovery_load_kernel && run usb_recovery_load_initrd && run usb_recovery_boot || run usb_factory_fail
reflash_check=run usb_factory_prog

/* Wizard factory-reflash entry point. */
osmigrate_recovery_boot=ubi part rootfs && if env exists kernel_active && env exists recovery_initrd_vol && ubi read 0x72000000 ${kernel_active} && ubi read 0x74000000 ${recovery_initrd_vol} ; then echo recovery from static volumes ; else ubifsmount ubi0:nedap9g45-rootfs && ubifsload 0x72000000 /boot/osmigrate/uImage && ubifsload 0x74000000 /boot/osmigrate/uInitrd ; fi && setenv initrd_high 0xffffffff && setenv bootargs console=ttyS0,115200 panic=10 loglevel=7 ${mtdparts} root=/dev/ram0 rw rdinit=/init osmigrate.recovery=1 ${osmigrate_recovery_args} && bootm 0x72000000 0x74000000
